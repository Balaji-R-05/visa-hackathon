# Copy to services/ai/.env. Real environment variables take precedence over this file.

# groq = hosted model (development) | ollama = local model, no data leaves the machine | none = no LLM
LLM_PROVIDER=groq
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=low

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Minimum share of numeric claims in a generated explanation that must match the engine's numbers
GROUNDING_MIN_SCORE=0.8

# Shared secret for service-to-service calls (set the same value for every service)
INTERNAL_SERVICE_TOKEN=
